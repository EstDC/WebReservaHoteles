---
import Layout from '../layouts/Layout.astro';
import ContactInfo from '../components/sections/ContactInfo.jsx';
import { motion } from 'framer-motion';
import Header from '../components/layout/Header.jsx';
---

<Layout>
<Header transparent client:load />
<div class="relative h-[400px]"">
  <!-- Video Background -->
  <div class="absolute inset-0 w-full h-[400px] overflow-hidden">
    {/* Fallback image */}
    <img 
      src="/images/img/trains-contact.jpg" 
      alt="Contact Background"
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[200%] h-[200%] object-cover"
    />
    <iframe
      src="https://www.youtube.com/embed/Q1S0bAOHZkI?autoplay=1&mute=1&loop=1&playlist=Q1S0bAOHZkI&controls=0&showinfo=0&rel=0&modestbranding=1&enablejsapi=1&origin=tu-dominio.com"
      class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[200%] h-[200%]"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
      loading="lazy"
    ></iframe>
    <div class="absolute inset-0 bg-black/50"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 text-center overflow-hidden">
    <h1 class="overflow-hidden">
      <span class="font-lorise-sans text-white text-6xl">Tu experiencia es </span>
      <span class="font-lorise-hand  text-9xl text-primary">nuestra</span>
      <span class="font-lorise-sans text-white text-6xl"> prioridad</span>
    </h1>
    <p class="text-xl text-white/90 max-w-2xl mx-auto">
      Si tienes preguntas, sugerencias o necesitas asistencia, estamos a un mensaje de distancia.
    </p>
  </div>
</div>
  <section class="bg-white overflow-x-hidden w-full max-w-full">
      <ContactInfo client:load />
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    font-family: Helvetica;
  }
</style> 
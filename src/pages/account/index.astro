---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import AccountLayout from '../../components/account/AccountLayout';
import StoreInitializer from '../../components/common/StoreInitializer';
import UserRoute from '../../components/auth/UserRoute';
---

<Layout title="Mi Cuenta">
  <Header transparent client:load />
  <StoreInitializer client:load />
  
  <main>
    <div class="relative">
      <!-- Video Background -->
      <div class="absolute inset-0 w-full h-[400px] overflow-hidden">
        {/* Fallback image */}
        <img 
          src="/images/img/account.jpg" 
          alt="Account Background"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[220%] h-[220%] object-cover"
        />
        <iframe
          src="https://www.youtube.com/embed/Za5giay17vQ?autoplay=1&mute=1&loop=1&playlist=Za5giay17vQ&controls=0&showinfo=0&rel=0&modestbranding=1&enablejsapi=1&origin=tu-dominio.com"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[220%] h-[220%]"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 text-center overflow-hidden">
        <h1 class="overflow-hidden">
          <span class="font-lorise-sans text-white text-7xl">Bienvenido a tu </span>
          <span class="font-lorise-hand  text-8xl text-primary">Cuenta</span>
        </h1>
        <p class="text-xl text-white/90 max-w-2xl mx-auto">
          Gestiona tus reservas, actualiza tu perfil y mantén al día tus preferencias
        </p>
      </div>

    <!-- Main Content -->
    <div class="mt-16 md:mt-24">
      <UserRoute client:load>
        <AccountLayout client:load />
      </UserRoute>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    font-family: Helvetica;
  }
</style> 
---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header';
import AccountLayout from '../../components/account/AccountLayout';
import StoreInitializer from '../../components/common/StoreInitializer';
---

<Layout title="Mi Cuenta">
  <Header client:load />
  <StoreInitializer client:load />
  
  <main>
    <div class="relative">
      <!-- Video Background -->
      <div class="absolute inset-0 w-full h-[400px] overflow-hidden">
        <iframe
          src="https://www.youtube.com/embed/Za5giay17vQ?autoplay=1&mute=1&loop=1&playlist=Za5giay17vQ&controls=0&showinfo=0&rel=0&modestbranding=1"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[200%] h-[200%]"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-16 text-center">
        <h1 class="text-4xl font-bold text-white mb-4">Bienvenido a tu Cuenta</h1>
        <p class="text-xl text-white/90 max-w-2xl mx-auto">
          Gestiona tus reservas, actualiza tu perfil y mantén al día tus preferencias
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="mt-16 md:mt-24">
      <AccountLayout client:load />
    </div>
  </main>
</Layout>

<style is:global>
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #f9fafb;
  }
</style> 
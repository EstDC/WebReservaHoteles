---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.jsx';
import HotelList from '../components/hotel/HotelList.jsx';
import HotelFilters from '../components/hotel/HotelFilters.jsx';
import { SliderRelleno } from '../components/hotel/HeroSlider.jsx';
import HotelsVideoSection from '../components/hotel/HotelsVideoSection.jsx';

---

<Layout title="Hoteles - HotelFinder">
  <Header transparent client:load />
  <main class="p-0 m-0">
    <div class="bg-[#a89c91]">
      <SliderRelleno client:load />
    </div>
    <div class="relative">
      <div class="w-full flex flex-col lg:flex-row">
        <div class="w-full lg:w-80 lg:sticky lg:top-24 lg:h-fit lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto">
          <HotelFilters client:only="react" />
        </div>
        <div class="flex-1">
          <div class="w-full py-8 px-4">
            <HotelList client:only="react" />
          </div>
        </div>
      </div>
    </div>
    <HotelsVideoSection client:load />
  </main>
</Layout>

<style>
  :global(body) {
    font-family: Helvetica;
  }
</style> 
---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.jsx';
import LoginForm from '../../components/auth/LoginForm.jsx';
---

<Layout title="Iniciar Sesión - HotelFinder">
  <Header transparent client:load />
  <main class="relative min-h-screen flex items-center justify-center">
    {/* Video Background */}
    <div class="absolute inset-0 z-0">
      <div class="relative w-full h-full">
        {/* Fallback image */}
        <img 
          src="/images/img/walking_auth.jpg" 
          alt="Login Background"
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh] object-cover"
        />
        <iframe
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh]"
          src="https://www.youtube.com/embed/mcWB44uIIrQ?autoplay=1&mute=1&controls=0&loop=1&playlist=mcWB44uIIrQ&playsinline=1&showinfo=0&rel=0&modestbranding=1&enablejsapi=1&origin=tu-dominio.com"
          title="Background Video"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        />
      </div>
    </div>

    {/* Content */}
    <div class="relative z-10 w-full max-w-md mx-auto px-8 py-4 bg-white/60 backdrop-blur-sm rounded-lg">
      <div class="relative mb-8 flex justify-center">
        <div class="relative">
          <h1 class="font-alcantera-script text-9xl text-primary">Iniciar</h1>
          <h1 class="font-lorise-sans text-7xl absolute -bottom-2 left-[30%]">Sesión</h1>
        </div>
      </div>
      <LoginForm client:load />
      <p class="text-center text-gray-900 font-helvetica mb-4">
        ¿No tienes una cuenta? 
        <a href="/auth/register" class="text-primary hover:text-gray-900 transition-colors ml-1">Regístrate aquí</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    font-family: 'Montserrat', sans-serif;
  }
</style> 
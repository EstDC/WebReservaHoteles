---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.jsx';
import LoginForm from '../../components/auth/LoginForm.jsx';
---

<Layout title="Iniciar Sesión - HotelFinder">
  <Header client:load />
  <main class="relative min-h-screen flex items-center justify-center">
    {/* Video Background */}
    <div class="absolute inset-0 z-0">
      <div class="relative w-full h-full">
        <iframe
          class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[100vw] h-[56.25vw] min-h-[100vh] min-w-[177.77vh]"
          src="https://www.youtube.com/embed/mcWB44uIIrQ?autoplay=1&mute=1&controls=0&loop=1&playlist=mcWB44uIIrQ&playsinline=1&showinfo=0&rel=0&modestbranding=1"
          title="Background Video"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    </div>

    {/* Content */}
    <div class="relative z-10 w-full max-w-md mx-auto px-8 py-10 bg-white/60 backdrop-blur-sm rounded-lg">
      <h1 class="text-4xl font-bold mb-8 text-center text-gray-900">Iniciar Sesión</h1>
      <LoginForm client:load />
      <p class="mt-4 text-center text-gray-900">
        ¿No tienes una cuenta? 
        <a href="/auth/register" class="text-primary hover:text-gray-900 transition-colors ml-1">Regístrate aquí</a>
      </p>
    </div>
  </main>
</Layout>

<style>
  :global(body) {
    font-family: 'Montserrat', sans-serif;
  }
</style> 